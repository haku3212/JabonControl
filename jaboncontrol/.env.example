# Configuración de la Aplicación

# API Backend
VITE_API_URL=http://localhost:3000/api

# Autenticación
VITE_AUTH_ENABLED=false
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=

# Base de datos
VITE_DB_TYPE=localStorage
# VITE_DB_URL=mongodb://localhost:27017

# Modo desarrollo
VITE_DEBUG=true

# Reportes
VITE_REPORTS_EXPORT=true
VITE_EXPORT_FORMAT=pdf,excel

# Notificaciones
VITE_NOTIFICATIONS_ENABLED=true
VITE_NOTIFICATION_TIMEOUT=3000
