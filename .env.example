NODE_ENV=production
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE
# PGSSL=false solo si usa PostgreSQL local sin SSL.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_ALEATORIO
ADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_ADMIN_SEGURA
ENABLE_DEMO_DATA=false
CORS_ORIGIN=https://TU-DOMINIO-O-URL-RAILWAY
JWT_EXPIRE=7d
PASSWORD_MAX_DAYS=180
AUTH_COOKIE_NAME=jc_session
